using System;
using Game.Foundation.Gui;

// 裂谷竞技 · ARENA 入口：建宿主 → 跑主循环。
//
// 玩法在 ArenaGame（纯逻辑）、渲染在 ArenaView、输入在 ArenaApp；
// 这里只负责把窗口和主循环接起来。
public class ArenaProgram {
    static void Main() {
        ArenaApp app = new ArenaApp();
        GuiHost host = new GuiHost("裂谷竞技 · ARENA", 960, 600, 16);
        host.Run(app);
    }
}
