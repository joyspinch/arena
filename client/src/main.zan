using System;
using Gui;
using Gui.Backend;

// 裂谷竞技 · ARENA —— 阶段一：项目骨架 + 最小可玩场景。
//
// 参考源：teeworlds/teeworlds（代码为宽松 zlib-like 许可；data/datasrc 下
// 素材除字体外全部 CC-BY-SA 3.0，见 license.txt）。
// 抄的是它的"确定性 tick + 客户端预测 + 多人同步"架构与俯视竞技手感，
// 不是代码、不是素材。后期联机走 Zan.Game.Net.LockstepManager。
//
// Zan 路线：2D sprite 批（Gui.SpriteBatch）+ 圆形碰撞；后期接
// Canvas.SpriteHandle / DrawSprites，素材 5 向序列帧（左右镜像省一半）。
//
// 环境变量：ARENA_SMOKE=1 / ARENA_FRAMES=<n> / ARENA_CAPTURE=<path.zpx>
public class Program {
    Form form;
    App app;
    GameShell shell;
    int frames = 0;
    int tick = 0;

    const int MapW = 960;
    const int MapH = 600;

    // 玩家
    float px = 120.0f;
    float py = 120.0f;
    float pvx = 0.0f;
    float pvy = 0.0f;
    int pHealth = 100;

    // 敌人 4 个
    float[] ex = new float[4];
    float[] ey = new float[4];
    float[] evx = new float[4];
    float[] evy = new float[4];
    int[] eHealth = new int[4];

    static void Main() {
        Program p = new Program();
        p.Run();
    }

    void Run() {
        form = Form.CreateDark("裂谷竞技 · ARENA", 1280, 720);
        app = form.GetApp();
        app.UseSkin("dark");
        Canvas.SetBackend(1);
        // 外壳：存档（最高分/局数）+ 设置浮层。浮层是标准库控件，
        // 盖在直绘画面之上——Esc 开关。
        this.shell = new GameShell();
        form.Add(this.shell.Overlay().Root());
        for (int i = 0; i < 4; i = i + 1) {
            ex[i] = 700.0f + (float)(i * 60);
            ey[i] = 90.0f + (float)(i * 130);
            evx[i] = -40.0f;
            evy[i] = 20.0f;
            eHealth[i] = 30;
        }
        app.Show();
        app.RequestRedraw();
        while (true) {
            int got = app.PollOneEvent();
            if (got < 0) {
                this.Finish();
                break;
            }
            // Esc 开关设置浮层（只有真有事件时才看键码，否则会拿上一帧的
            // 残留值反复开关）。
            if (got == 1 && app.window.EventKind() == 4
                && app.window.EventKeyCode() == Keys.Escape()) {
                this.shell.Overlay().Toggle();
            }
            this.shell.Overlay().Tick();
            Tick(16);
            app.BeginFrame();
            Render();
            // 控件树叠在直绘之上：测量 → 排布 → 绘制。
            form.MeasureTree(app);
            form.Arrange(app.ShapeOffX(), app.ContentTop() + app.ShapeOffY(),
                app.ClientWidth(), app.ClientHeight() - app.ContentTop());
            form.RenderTree(app);
            app.RenderChrome("裂谷竞技 · ARENA");
            frames = frames + 1;
            string capture = Environment.GetEnvironmentVariable("ARENA_CAPTURE");
            if (capture != "" && frames == 60) {
                app.canvas.WritePixels(capture, 0, 0, app.ClientWidth(), app.ClientHeight());
                Console.WriteLine("ARENA_CAPTURE " + Convert.ToString(app.ClientWidth())
                    + "x" + Convert.ToString(app.ClientHeight()));
            }
            app.PresentFrame();
            if (IsSmoke() && frames >= SmokeFrames()) {
                Console.WriteLine("ARENA_SMOKE_OK frames=" + Convert.ToString(frames)
                    + " tick=" + Convert.ToString(tick));
                this.Finish();
                break;
            }
            app.RequestRedraw();
            Window.SleepMs(16);
        }
    }

    // 收尾：存档落盘 + 打印读回值（测试脚本靠这行验证"跑两遍读得到"）。
    void Finish() {
        this.shell.Save();
        Console.WriteLine("ARENA_SAVE best=" + Convert.ToString(this.shell.Best())
            + " runs=" + Convert.ToString(this.shell.Runs()));
    }

    bool IsSmoke() {
        return Environment.GetEnvironmentVariable("ARENA_SMOKE") == "1";
    }

    int SmokeFrames() {
        string v = Environment.GetEnvironmentVariable("ARENA_FRAMES");
        if (v == "") { return 90; }
        return Convert.ToInt32(v);
    }

    void Tick(int dt) {
        tick = tick + 1;
        float f = (float)dt / 1000.0f;
        // 玩家绕圈跑（后期换成输入驱动）
        float ang = (float)tick * 0.02f;
        pvx = (float)Math.Cos(ang) * 140.0f;
        pvy = (float)Math.Sin(ang) * 140.0f;
        px = px + pvx * f;
        py = py + pvy * f;
        if (px < 20.0f) { px = 20.0f; }
        if (px > (float)MapW - 20.0f) { px = (float)MapW - 20.0f; }
        if (py < 20.0f) { py = 20.0f; }
        if (py > (float)MapH - 20.0f) { py = (float)MapH - 20.0f; }
        // 敌人追踪玩家 + 撞墙反弹
        for (int i = 0; i < 4; i = i + 1) {
            float dx = px - ex[i];
            float dy = py - ey[i];
            float d = (float)Math.Sqrt(dx * dx + dy * dy);
            if (d > 0.01f) {
                // 难度档（1/2/3）决定敌人追击的快慢——设置不是摆设。
                float chase = 18.0f + 12.0f * (float)this.shell.SpeedLevel();
                evx[i] = evx[i] + dx / d * chase * f;
                evy[i] = evy[i] + dy / d * chase * f;
            }
            ex[i] = ex[i] + evx[i] * f;
            ey[i] = ey[i] + evy[i] * f;
            if (ex[i] < 20.0f || ex[i] > (float)MapW - 20.0f) { evx[i] = -evx[i]; }
            if (ey[i] < 20.0f || ey[i] > (float)MapH - 20.0f) { evy[i] = -evy[i]; }
            if (d < 26.0f && eHealth[i] > 0) {
                eHealth[i] = eHealth[i] - 1;
                if (eHealth[i] <= 0) {
                    ex[i] = 700.0f; ey[i] = 90.0f; eHealth[i] = 30;
                }
            }
        }
    }

    void Render() {
        Canvas c = app.canvas;
        int w = c.Width();
        int h = c.Height();
        c.FillRect(0, 0, w, h, 0xFF14181F);
        // 竞技场地面 + 网格
        c.FillRect(0, 0, MapW, MapH, 0xFF1E2530);
        for (int gx = 0; gx <= MapW; gx = gx + 64) {
            c.DrawLine(gx, 0, gx, MapH, 0xFF2A3444, 1);
        }
        for (int gy = 0; gy <= MapH; gy = gy + 64) {
            c.DrawLine(0, gy, MapW, gy, 0xFF2A3444, 1);
        }
        c.DrawRect(0, 0, MapW, MapH, 0xFF3C4A5E, 2);
        // 掩体
        c.FillRect(300, 200, 80, 40, 0xFF2F3A4A);
        c.DrawRect(300, 200, 80, 40, 0xFF46566E, 2);
        c.FillRect(600, 380, 80, 40, 0xFF2F3A4A);
        c.DrawRect(600, 380, 80, 40, 0xFF46566E, 2);
        // 敌人
        for (int i = 0; i < 4; i = i + 1) {
            int col = eHealth[i] > 0 ? 0xFFCE4A4A : 0xFF4A4A4A;
            c.FillCircle((int)ex[i], (int)ey[i], 14, col);
            c.DrawCircle((int)ex[i], (int)ey[i], 14, 0xFF8A2020, 2);
        }
        // 玩家
        c.FillCircle((int)px, (int)py, 16, 0xFF3E8FD6);
        c.DrawCircle((int)px, (int)py, 16, 0xFF1B4F80, 2);
        c.FillRect((int)px - 4, (int)py - 20, 8, 8, 0xFFE8F0FA);
        // 血条
        c.FillRect(16, 16, 220, 16, 0xFF22262E);
        c.FillRect(16, 16, 220 * pHealth / 100, 16, 0xFF48C78E);
        c.DrawRect(16, 16, 220, 16, 0xFF3C4A5E, 1);
        c.DrawText(244, 16, "HP " + Convert.ToString(pHealth), 0xFFE8F0FA, 14);
        c.DrawText(16, 44, "tick=" + Convert.ToString(tick) + "  frames=" + Convert.ToString(frames),
            0xFF9FB0C6, 14);
        c.DrawText(16, h - 50, "Esc 打开设置", 0xC09FB0C6, 14);
        c.DrawText(16, h - 26, "TODO 位图：角色 5 向帧 / 枪口火焰 / 子弹 sprite / 掩体贴图 / 命中特效",
            0xC09FB0C6, 14);
    }
}
